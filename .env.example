# Modelo de Claude a usar vía Claude Agent SDK (sesión de `claude login`, sin API key)
CLAUDE_MODEL=claude-sonnet-5
# Núcleos para el render (0 = automático: nº de CPUs - 1)
TF_WORKERS=0
# Carpeta de proyectos
# TF_PROJECTS_DIR=./projects
# Pon 1 solo si quieres permitir que el CLI use ANTHROPIC_API_KEY en lugar de tu sesión
TF_ALLOW_API_KEY=0
